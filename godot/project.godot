; Engine configuration file.
; Projeto único para Web (HTML5/WebAssembly) e Android. Somente horizontal.

config_version=5

[application]

config/name="Quem Sou Eu"
config/description="Jogo de personagens: lobby, Modo História, Modo Duelo e Configurações."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

PlayerData="*res://scripts/core/player_data.gd"
GameSettings="*res://scripts/core/game_settings.gd"
OrientationGuard="*res://scripts/ui/orientation_guard.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]

theme/custom="res://themes/menu_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
